# Environment contract for this project.
#
# There are NO secrets here, and there never will be — the portfolio calls no
# paid service. Every value below is optional and has a working default, so a
# fresh clone runs with no .env file at all.
#
# Copy to .env.local only if you want to override something.

# Absolute origin, used for canonical URLs and social preview images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog section is built but hidden until there is something to publish.
NEXT_PUBLIC_ENABLE_BLOG=false

# Analytics stays off unless deliberately switched on.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
