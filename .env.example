# This file documents every variable the site understands.
#
# You do NOT need a .env file to run or deploy this project. Every value here
# has a working default, and on Vercel the two that matter are injected
# automatically. Copy this to .env.local only if you want to override one.

# Absolute origin, used for canonical URLs, the sitemap and the social card.
# Leave unset on Vercel: it is derived from the deployment host. Set it once
# you have a custom domain, so canonical URLs point at the domain rather than
# the *.vercel.app address.
# NEXT_PUBLIC_SITE_URL=https://mdfaiz.dev

# Injected by Vercel. 'production' | 'preview' | 'development'.
# Only set this by hand to reproduce a deployment locally.
# NEXT_PUBLIC_VERCEL_ENV=development

# Override for search indexing. Unset means: index production, and refuse to
# index previews and local builds. Set to 'false' on production to pull the
# site out of search results without taking it down.
# NEXT_PUBLIC_ALLOW_INDEXING=true
